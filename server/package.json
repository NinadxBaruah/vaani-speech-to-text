{
  "name": "@stt/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "smoke:stt": "tsx scripts/smoke-stt.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
