# Sarvam AI key — https://dashboard.sarvam.ai (never exposed to the browser)
SARVAM_API_KEY=

# Postgres connection string (Neon, RDS, local…). Include sslmode=require for hosted DBs.
DB_URI=postgresql://user:password@host/dbname?sslmode=require

# Optional
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Hard cap on one live transcription session, in seconds
MAX_SESSION_SECONDS=600

# Self-hosted Whisper sidecar (stt-local). Leave empty to disable that engine.
# Local dev: npm run stt-local  → http://localhost:8001 ; docker compose sets http://stt-local:8000
LOCAL_STT_URL=
